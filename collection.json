				],
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "加入购物车",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"加入购物车返回成功\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"业务响应码为0\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(0);",
							"});",
							"",
							"pm.test(\"响应体中包含items数组（可能为空）\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('items');",
							"    pm.expect(jsonData.items).to.be.an('array');",
							"});",
							"",
							"// 仅当 items 有内容时，才校验 productId",
							"pm.test(\"若购物车有商品，则第一个商品应有productId\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.items && jsonData.items.length > 0) {",
							"        pm.expect(jsonData.items[0]).to.have.property('productId');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "default"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"productId\": 103,\n    \"quantity\": 1\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/cart",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"cart"
					]
				}
			},
			"response": []
		},
		{
			"name": "查询购物车",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"查询购物车成功\",function(){",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(0);",
							"    pm.expect(jsonData.items).to.be.an('array');",
							"    // 验证硬编码的 103 是否在购物车里（关键！）",
							"    var found = jsonData.items.some(item => item.productId === 103);",
							"    pm.expect(found).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "default"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/cart",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"cart"
					]
				}
			},
			"response": []
		},
		{
			"name": "创建订单",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"创建订单成功\", function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(0);",
							"    pm.environment.set(\"orderId\", jsonData.order.id);",
							"    pm.expect(jsonData.order).to.have.property('id');",
							"    pm.expect(jsonData.order.status).to.eql('pending');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
