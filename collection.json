	"item": [
		{
			"name": "异常场景",
			"item": [
				{
					"name": "加购-未登录",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"未登录加购应返回401\", function () {",
									"    pm.response.to.have.status(401);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.code).to.eql(401);",
									"    pm.expect(jsonData.message).to.include(\"登录\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer invalid_token",
								"type": "default",
								"disabled": true
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"productId\": 103, \"quantity\": 1}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"cart"
							]
						}
					},
					"response": []
				},
