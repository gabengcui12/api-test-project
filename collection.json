		{
			"name": "查询订单详情",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"查询订单详情成功\", function () {",
							"    pm.response.to.have.status(200);",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.code).to.eql(0);",
							"    pm.expect(jsonData.order.id).to.eql(pm.environment.get(\"orderId\"));",
							"    pm.expect(jsonData.order.status).to.eql(\"pending\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "default"
